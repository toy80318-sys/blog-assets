{
  "manifest_version": 3,
  "name": "토이블록 네이버 블로그 도우미",
  "version": "1.11.1",
  "description": "토이블록 네이버 블로그 도우미 — 소제목·인용구 서식 단축키, 블로그 채널·포스트 분석과 검색 노출 확인, 이웃 소통 댓글 도우미.",
  "permissions": [
    "storage",
    "alarms",
    "debugger",
    "offscreen",
    "clipboardWrite",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://blog.naver.com/*",
    "https://*.blog.naver.com/*",
    "https://search.naver.com/*"
  ],
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "https://aistudio.google.com/*",
    "https://platform.claude.com/*",
    "https://console.anthropic.com/*",
    "https://platform.openai.com/*"
  ],
  "action": {
    "default_title": "토이블록 네이버 블로그 도우미",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://blog.naver.com/*",
        "https://*.blog.naver.com/*"
      ],
      "js": [
        "features.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://blog.naver.com/*",
        "https://*.blog.naver.com/*"
      ],
      "js": [
        "panel.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://blog.naver.com/*",
        "https://*.blog.naver.com/*",
        "https://search.naver.com/*"
      ],
      "js": [
        "features.js",
        "comment.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://blog.naver.com/BuddyAdd*",
        "https://m.blog.naver.com/BuddyAdd*"
      ],
      "js": [
        "buddy.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "slot-1": {
      "description": "단축키1 실행 (기능은 확장 설정에서 선택)",
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "MacCtrl+Shift+1"
      }
    },
    "slot-2": {
      "description": "단축키2 실행 (기능은 확장 설정에서 선택)",
      "suggested_key": {
        "default": "Ctrl+Shift+2",
        "mac": "MacCtrl+Shift+2"
      }
    },
    "slot-3": {
      "description": "단축키3 실행 (기능은 확장 설정에서 선택)",
      "suggested_key": {
        "default": "Ctrl+Shift+3",
        "mac": "MacCtrl+Shift+3"
      }
    },
    "slot-4": {
      "description": "단축키4 실행 (기능은 확장 설정에서 선택)",
      "suggested_key": {
        "default": "Ctrl+Shift+4",
        "mac": "MacCtrl+Shift+4"
      }
    },
    "slot-5": {
      "description": "단축키5 실행 (기능은 확장 설정에서 선택)"
    },
    "slot-6": {
      "description": "단축키6 실행 (기능은 확장 설정에서 선택)"
    },
    "slot-7": {
      "description": "단축키7 실행 (기능은 확장 설정에서 선택)"
    },
    "slot-8": {
      "description": "단축키8 실행 (기능은 확장 설정에서 선택)"
    }
  }
}
